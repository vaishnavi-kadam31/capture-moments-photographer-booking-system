# Copy these into your shell / systemd service on the server. Not needed for local development.
DJANGO_SECRET_KEY=put-a-long-random-string-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-ec2-public-dns-or-ip
DJANGO_CSRF_TRUSTED_ORIGINS=http://your-ec2-public-dns-or-ip
USE_S3=True
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=ap-south-1
